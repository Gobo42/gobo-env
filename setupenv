#!/usr/bin/env bash

#If you get \033 \033 errors on noninteractive shells, then this is missing from the beginning of your .bashrc file
#case $- in
#    *i*) ;;
#      *) return;;
#esac

#detect the user who invoked sudo (falls back to logname for direct root logins, then $USER)
TARGET_USER="${SUDO_USER:-$(logname 2>/dev/null)}"
TARGET_USER="${TARGET_USER:-$USER}"
#resolve their real home dir - under sudo, $HOME/~ point at root's home, not theirs
TARGET_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
TARGET_HOME="${TARGET_HOME:-$HOME}"

#if .bashrc isn't running this is missing from .profile
if [ -n "$BASH_VERSION" ]; then
    # include .bashrc if it exists
    if [ -f "$TARGET_HOME/.bashrc" ]; then
    . "$TARGET_HOME/.bashrc"
    fi
fi

#detect distro family
if [ -f /etc/os-release ]; then
    . /etc/os-release
    if [ "$ID" = "debian" ] || [ "$ID" = "ubuntu" ] || [[ "$ID_LIKE" == *debian* ]]; then
        DISTRO_FAMILY="debian"
    else
        DISTRO_FAMILY="rhel"
    fi
else
    DISTRO_FAMILY="rhel"
fi

#default packages installed on every system - add new ones here
COMMON_PACKAGES="vim fastfetch vim-fugitive vim-ale"

#install a package if it isn't already present - pass a second arg if the install
#target differs from the package/check name (e.g. a URL to an rpm). Reports an
#error and skips it (without aborting the script) if the install fails.
ensure_pkg() {
    local pkg="$1"
    local install_target="${2:-$1}"
    if [ "$DISTRO_FAMILY" = "debian" ]; then
        dpkg -s "$pkg" &>/dev/null && return
        apt-get -y install "$install_target" || echo "ERROR: failed to install '$pkg' - skipping" >&2
    else
        rpm -q "$pkg" &>/dev/null && return
        dnf -y install "$install_target" || echo "ERROR: failed to install '$pkg' - skipping" >&2
    fi
}

#install multiple packages in a single batched call, skipping any already installed.
#a single unknown package name fails the whole batch on both apt and dnf, so on
#failure fall back to installing (and reporting/skipping) the rest one at a time
ensure_pkgs() {
    local pkg missing=()
    for pkg in "$@"; do
        if [ "$DISTRO_FAMILY" = "debian" ]; then
            dpkg -s "$pkg" &>/dev/null || missing+=("$pkg")
        else
            rpm -q "$pkg" &>/dev/null || missing+=("$pkg")
        fi
    done
    [ "${#missing[@]}" -eq 0 ] && return

    if [ "$DISTRO_FAMILY" = "debian" ]; then
        apt-get -y install "${missing[@]}" && return
    else
        dnf -y install "${missing[@]}" && return
    fi

    for pkg in "${missing[@]}"; do
        ensure_pkg "$pkg"
    done
}

#make sure baseline tools are present
ensure_pkgs curl wget bat

if ! grep -q bash_aliases "$TARGET_HOME/.bashrc"; then
    echo "" >> "$TARGET_HOME/.bashrc"
    echo "if [ -f ~/.bash_aliases ]; then" >> "$TARGET_HOME/.bashrc"
    echo "    . ~/.bash_aliases" >> "$TARGET_HOME/.bashrc"
    echo "fi" >> "$TARGET_HOME/.bashrc"
    echo "" >> "$TARGET_HOME/.bashrc"
fi
[ -z "$(grep "histappend" "$TARGET_HOME/.bashrc")" ] && echo "shopt -s histappend" >> "$TARGET_HOME/.bashrc"
[ -z "$(grep "HISTSIZE" "$TARGET_HOME/.bashrc")" ] && echo "HISTSIZE=1000" >> "$TARGET_HOME/.bashrc"
[ -z "$(grep "HISTFILESIZE" "$TARGET_HOME/.bashrc")" ] && echo "HISTFILESIZE=2000" >> "$TARGET_HOME/.bashrc"
[ -z "$(grep "checkwinsize" "$TARGET_HOME/.bashrc")" ] && echo "shopt -s checkwinsize" >> "$TARGET_HOME/.bashrc"
[ -z "$(grep "GCC_COLORS" "$TARGET_HOME/.bashrc")" ] && echo "export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'" >> "$TARGET_HOME/.bashrc"
[ -z "$(grep "SYSTEMD_EDITOR" "$TARGET_HOME/.bashrc")" ] && echo "export SYSTEMD_EDITOR=vim" >> "$TARGET_HOME/.bashrc"
#suppresses the "(.venv)" prompt prefix from any venv's activate script, without needing to patch the script itself
[ -z "$(grep "VIRTUAL_ENV_DISABLE_PROMPT" "$TARGET_HOME/.bashrc")" ] && echo "export VIRTUAL_ENV_DISABLE_PROMPT=1" >> "$TARGET_HOME/.bashrc"
#recreate .bash_aliases from scratch
cat > "$TARGET_HOME/.bash_aliases" <<'EOF'
alias vi=vim
alias sudo='sudo -E '
alias grep='grep --color=auto'
alias ls='ls --color=auto -h --group-directories-first'
EOF
#more -e doesn't work on rocky
[ "$DISTRO_FAMILY" = "debian" ] && echo "alias more='more -e'" >> "$TARGET_HOME/.bash_aliases"
#debian's bat package ships the binary as batcat (name collision with another package); rocky's doesn't
[ "$DISTRO_FAMILY" = "debian" ] && echo "alias bat='batcat'" >> "$TARGET_HOME/.bash_aliases"

#de-duplicate any aliases defined more than once, keeping the last definition
awk -F= '{ name=$1; last[name]=$0; if (!(name in seen)) { order[++n]=name; seen[name]=1 } }
         END { for (i=1;i<=n;i++) print last[order[i]] }' "$TARGET_HOME/.bash_aliases" > "$TARGET_HOME/.bash_aliases.tmp" && mv "$TARGET_HOME/.bash_aliases.tmp" "$TARGET_HOME/.bash_aliases"


#fix screwup from earlier
[[ $EUID -eq 0 ]] && [ -f "/etc/sudoers.d/gobo" ] && [ ! -z "$(grep "root" /etc/sudoers.d/gobo)" ] && sed -i "s/root/${TARGET_USER}/" /etc/sudoers.d/gobo
if [[ $EUID -eq 0 ]] && [ -d "/etc/sudoers.d" ] && [ ! -f "/etc/sudoers.d/gobo" ]; then
    echo "${TARGET_USER}    ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/gobo
    chmod 440 /etc/sudoers.d/gobo
    visudo -cf /etc/sudoers.d/gobo || rm -f /etc/sudoers.d/gobo
fi

if [ "$DISTRO_FAMILY" = "debian" ]; then
    #enable backports, then convert all sources to the new deb822 .sources format
    if [ -z "$(grep -rl "${VERSION_CODENAME}-backports" /etc/apt/sources.list /etc/apt/sources.list.d/ 2>/dev/null)" ]; then
        echo "deb [signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] http://deb.debian.org/debian ${VERSION_CODENAME}-backports main contrib non-free non-free-firmware" > /etc/apt/sources.list.d/backports.list
    fi
    apt modernize-sources -y

    #make sure the standard debian.sources components include contrib/non-free/non-free-firmware
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then
        while IFS= read -r line; do
            if [[ "$line" == Components:* ]]; then
                for comp in contrib non-free non-free-firmware; do
                    [[ " $line " == *" $comp "* ]] || line="$line $comp"
                done
            fi
            echo "$line"
        done < /etc/apt/sources.list.d/debian.sources > /etc/apt/sources.list.d/debian.sources.tmp
        mv /etc/apt/sources.list.d/debian.sources.tmp /etc/apt/sources.list.d/debian.sources
    fi

    #now install stuff
    apt-get -y update
    ensure_pkgs $COMMON_PACKAGES dnsutils knot-dnsutils pdns-tools tealdeer ssh-import-id vim-nftables vim-syntastic vim-airline universal-ctags

    #turn on tealdeer's auto-update and seed its page cache now
    if [ -x "$(command -v tldr)" ]; then
        [ -f "$TARGET_HOME/.config/tealdeer/config.toml" ] || runuser -u "$TARGET_USER" -- tldr --seed-config
        awk '
            BEGIN { in_updates=0; have_auto_update=0; seen_updates_section=0 }
            /^\[updates\]/ { in_updates=1; seen_updates_section=1; print; next }
            /^\[/ {
                if (in_updates && !have_auto_update) { print "auto_update = true"; have_auto_update=1 }
                in_updates=0
                print
                next
            }
            {
                if (in_updates && $0 ~ /^[[:space:]]*auto_update[[:space:]]*=/) {
                    print "auto_update = true"
                    have_auto_update=1
                    next
                }
                print
            }
            END {
                if (in_updates && !have_auto_update) { print "auto_update = true"; have_auto_update=1 }
                if (!seen_updates_section) { print "[updates]"; print "auto_update = true" }
            }
        ' "$TARGET_HOME/.config/tealdeer/config.toml" > "$TARGET_HOME/.config/tealdeer/config.toml.tmp" && mv "$TARGET_HOME/.config/tealdeer/config.toml.tmp" "$TARGET_HOME/.config/tealdeer/config.toml"
        [[ $EUID -eq 0 ]] && chown -R "${TARGET_USER}:" "$TARGET_HOME/.config/tealdeer"
        runuser -u "$TARGET_USER" -- tldr --update
    fi
else
    #fix dnf
    [ -z "$(grep "fastestmirror" /etc/dnf/dnf.conf)" ] && echo "fastestmirror=True" >> /etc/dnf/dnf.conf
    [ -z "$(grep "max_parallel_downloads" /etc/dnf/dnf.conf)" ] && echo "max_parallel_downloads=5" >> /etc/dnf/dnf.conf

    #enable EPEL, CRB (aka PowerTools), extras, and elrepo - Rocky 9 / EL9 repo ids and URL
    ensure_pkgs dnf-plugins-core epel-release
    dnf config-manager --set-enabled crb extras
    ensure_pkg elrepo-release "https://www.elrepo.org/elrepo-release-9.el9.elrepo.noarch.rpm"

    #now install stuff - makecache just refreshes repo metadata; "dnf update" is an
    #alias for "upgrade" and would upgrade every installed package on the system
    dnf -y makecache
    ensure_pkgs $COMMON_PACKAGES bind-utils knot-utils pdns-tools tldr ctags
fi

#pull ssh public keys from github and drop them into the target user's authorized_keys.
#ssh-import-id is idempotent (skips keys it's already added), and creates ~/.ssh with
#the right permissions itself, so it just needs to run as that user, not root.
[ -x "$(command -v ssh-import-id)" ] && runuser -u "$TARGET_USER" -- ssh-import-id gh:gobo42

#interactive-shell-only settings: tab width, prompt, and the fastfetch banner.
#finds the existing "if [ -t 0 ]; then ... fi" block (if any) and only inserts
#whichever of these three lines are missing *inside that block* - the bashrc may
#have other PS1 lines earlier that are outside this block and must be ignored.
patch_interactive_bashrc() {
    local tabs_line='    tabs 4'
    local ps1_line='    PS1="(\[\033[01;34m\]\t\[\033[0m\])\[\033[38;5;10m\]\u\[\033[0m\]@\[\033[38;5;10m\]\h\[\033[0m\]:[\[\033[38;5;1m\]\w\[\033[0m\]]\$"'
    local fastfetch_line='    fastfetch'
    local want_fastfetch=0
    [ -x "$(command -v fastfetch)" ] && want_fastfetch=1

    mapfile -t lines < "$TARGET_HOME/.bashrc"

    local block_start=-1 block_end=-1 i
    for i in "${!lines[@]}"; do
        if [ "${lines[$i]}" = "if [ -t 0 ]; then" ]; then
            block_start=$i
            continue
        fi
        if [ "$block_start" -ge 0 ] && [ "${lines[$i]}" = "fi" ]; then
            block_end=$i
            break
        fi
    done

    local have_tabs=0 have_ps1=0 have_fastfetch=0
    if [ "$block_start" -ge 0 ] && [ "$block_end" -ge 0 ]; then
        for ((i = block_start + 1; i < block_end; i++)); do
            case "${lines[$i]}" in
                *"tabs 4"*) have_tabs=1 ;;
                *"PS1="*) have_ps1=1 ;;
                *"fastfetch"*) have_fastfetch=1 ;;
            esac
        done
    fi

    if [ "$block_start" -ge 0 ] && [ "$block_end" -ge 0 ]; then
        local new_lines=()
        [ "$have_tabs" -eq 0 ] && new_lines+=("$tabs_line")
        [ "$have_ps1" -eq 0 ] && new_lines+=("$ps1_line")
        [ "$want_fastfetch" -eq 1 ] && [ "$have_fastfetch" -eq 0 ] && new_lines+=("$fastfetch_line")
        if [ "${#new_lines[@]}" -gt 0 ]; then
            {
                printf '%s\n' "${lines[@]:0:$block_end}"
                printf '%s\n' "${new_lines[@]}"
                printf '%s\n' "${lines[@]:$block_end}"
            } > "$TARGET_HOME/.bashrc.tmp" && mv "$TARGET_HOME/.bashrc.tmp" "$TARGET_HOME/.bashrc"
        fi
    else
        {
            echo ""
            echo "#interactive shell settings"
            echo "if [ -t 0 ]; then"
            echo "$tabs_line"
            echo "$ps1_line"
            [ "$want_fastfetch" -eq 1 ] && echo "$fastfetch_line"
            echo "fi"
        } >> "$TARGET_HOME/.bashrc"
    fi
}
patch_interactive_bashrc

#fix .vimrc
[ ! -f "$TARGET_HOME/.vimrc" ] && touch "$TARGET_HOME/.vimrc"
[ -z "$(grep "\$VIMRUNTIME" "$TARGET_HOME/.vimrc")" ] && echo "source \$VIMRUNTIME/defaults.vim" >> "$TARGET_HOME/.vimrc"
[ -z "$(grep "mouse-=a" "$TARGET_HOME/.vimrc")" ] && echo "set mouse-=a" >> "$TARGET_HOME/.vimrc"
[ -z "$(grep "tabstop=4" "$TARGET_HOME/.vimrc")" ] && echo "set tabstop=4" >> "$TARGET_HOME/.vimrc"
[ -z "$(grep "shiftwidth=4" "$TARGET_HOME/.vimrc")" ] && echo "set shiftwidth=4" >> "$TARGET_HOME/.vimrc"
[ -z "$(grep "expandtab" "$TARGET_HOME/.vimrc")" ] && echo "set expandtab" >> "$TARGET_HOME/.vimrc"
[ -z "$(grep "smarttab" "$TARGET_HOME/.vimrc")" ] && echo "set smarttab" >> "$TARGET_HOME/.vimrc"
[ -z "$(grep "autoindent" "$TARGET_HOME/.vimrc")" ] && echo "set autoindent" >> "$TARGET_HOME/.vimrc"
[ -z "$(grep "smartindent" "$TARGET_HOME/.vimrc")" ] && echo "set smartindent" >> "$TARGET_HOME/.vimrc"
[ -z "$(grep "wrap" "$TARGET_HOME/.vimrc")" ] && echo "set wrap" >> "$TARGET_HOME/.vimrc"
[ -z "$(grep "magic" "$TARGET_HOME/.vimrc")" ] && echo "set magic" >> "$TARGET_HOME/.vimrc"
[ -z "$(grep "hidden" "$TARGET_HOME/.vimrc")" ] && echo "set hidden" >> "$TARGET_HOME/.vimrc"
[ -z "$(grep "showmatch" "$TARGET_HOME/.vimrc")" ] && echo "set showmatch" >> "$TARGET_HOME/.vimrc"
[ -z "$(grep "nnoremap <C-L>" "$TARGET_HOME/.vimrc")" ] && echo "nnoremap <C-L> :nohl<cr><C-L>" >> "$TARGET_HOME/.vimrc"

#dotfiles may have just been created by root - make sure the target user actually owns them
[[ $EUID -eq 0 ]] && chown "${TARGET_USER}:" "$TARGET_HOME/.bashrc" "$TARGET_HOME/.bash_aliases" "$TARGET_HOME/.vimrc" 2>/dev/null

. "$TARGET_HOME/.bashrc"
